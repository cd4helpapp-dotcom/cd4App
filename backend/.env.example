# Copy to .env. Never commit .env.

# Database, used by docker compose and Prisma
POSTGRES_DB=cd4
POSTGRES_USER=cd4
POSTGRES_PASSWORD=change-me
# Prisma, when run outside Docker
DATABASE_URL=postgresql://cd4:change-me@localhost:5433/cd4

# Security. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:8082

# Razorpay. Leave empty to use test mode, where no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agora calls
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# CD4 AI
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-5.6-terra
AI_QUALITY_MODEL=gpt-5.6-sol

# Pro plan prices in rupees
PRO_MONTHLY_PRICE_INR=99
PRO_YEARLY_PRICE_INR=999

# Creates the first admin once. Remove these after the first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Uploaded files
STORAGE_DIR=/data/uploads
