// The database schema for the CD4 Java backend. Prisma owns the tables and migrations; Spring Data JPA reads and writes them
// and checks at start-up that its models still match (spring.jpa.hibernate.ddl-auto=validate).
// Field names are the column names, so there is one name for each thing across SQL, Prisma and Java.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Accounts ----------

model User {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique
  password_hash      String?
  email_verified_at  DateTime? @db.Timestamptz(6)
  disabled_at        DateTime? @db.Timestamptz(6)
  failed_login_count Int       @default(0)
  locked_until       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  profile        Profile?
  refresh_tokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  family_id   String    @db.Uuid
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  replaced_by String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  permissions String[]
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  profiles Profile[]

  @@map("roles")
}

model Profile {
  id                      String    @id @db.Uuid
  first_name              String
  last_name               String
  email                   String    @unique
  phone_number            String?   @unique
  age                     Int?
  gender                  String?
  address                 String?
  weight                  Decimal?  @db.Decimal
  blood_pressure          String?
  pulse                   Int?
  profile_picture         String?
  profile_setup_completed Boolean   @default(false)
  is_verified             Boolean   @default(false)
  role_id                 String    @db.Uuid
  settings                Json      @default("{}")
  push_token              String?
  last_seen_at            DateTime? @default(now()) @db.Timestamptz(6)
  chat_public_key         String?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id])

  doctor Doctor?

  @@index([role_id])
  @@map("profiles")
}

// ---------- Doctors and booking ----------

model Doctor {
  id                         String    @id @db.Uuid
  city                       String
  specialization             String
  experience                 String
  fee                        String
  bio                        String?
  rating                     Decimal?  @default(5.0) @db.Decimal
  registration_number        String    @unique
  kyc_verify                 Boolean   @default(false)
  documents                  String[]
  degree                     String?
  university                 String?
  year_of_completion         Int?
  registration_council       String?
  current_hospital_clinic    String?
  previous_work_details      String?
  areas_of_expertise         String[]  @default([])
  languages_spoken           String[]  @default([])
  treatment_approach         String?
  profile_completion_done    Boolean   @default(false)
  profile_completion_done_at DateTime? @db.Timestamptz(6)
  is_verified                Boolean   @default(false)
  signature_path             String?
  last_seen_at               DateTime? @default(now()) @db.Timestamptz(6)
  created_at                 DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  profile Profile @relation(fields: [id], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([specialization])
  @@map("doctors")
}

model Slot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id      String   @db.Uuid
  date           DateTime @db.Date
  start_time     DateTime @db.Time(6)
  end_time       DateTime @db.Time(6)
  is_booked      Boolean  @default(false)
  appointment_id String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([doctor_id, date, start_time])
  @@index([doctor_id, date])
  @@map("slots")
}

model Appointment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id         String    @db.Uuid
  doctor_id          String    @db.Uuid
  slot_id            String    @db.Uuid
  status             String    @default("pending")
  notes              String?
  meet_link          String?
  ai_report_id       String?   @db.Uuid
  appointment_type   String    @default("consultation")
  doctor_notified_at DateTime? @db.Timestamptz(6)
  cancelled_at       DateTime? @db.Timestamptz(6)
  cancelled_by       String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([patient_id, created_at])
  @@index([doctor_id, created_at])
  @@index([slot_id])
  @@map("appointments")
}

model DoctorPayout {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id         String    @db.Uuid
  created_by        String    @db.Uuid
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("INR")
  status            String    @default("paid")
  payment_reference String?
  notes             String?
  paid_at           DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([doctor_id])
  @@map("doctor_payouts")
}

model AppointmentPayment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointment_id      String?   @db.Uuid
  patient_id          String    @db.Uuid
  doctor_id           String    @db.Uuid
  slot_id             String    @db.Uuid
  provider            String    @default("razorpay")
  order_id            String    @unique
  payment_id          String?
  signature           String?
  status              String    @default("created")
  gross_amount        Decimal   @db.Decimal(10, 2)
  doctor_share        Decimal   @db.Decimal(10, 2)
  platform_commission Decimal   @db.Decimal(10, 2)
  currency            String    @default("INR")
  paid_at             DateTime? @db.Timestamptz(6)
  metadata            Json      @default("{}")
  payout_status       String    @default("pending")
  payout_id           String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([patient_id])
  @@index([doctor_id])
  @@index([slot_id, status])
  @@map("appointment_payments")
}

model PaymentWebhookEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         String    @default("razorpay")
  event_id         String    @unique
  event_type       String
  payload          Json
  processed        Boolean   @default(false)
  processed_at     DateTime? @db.Timestamptz(6)
  processing_error String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@map("payment_webhook_events")
}

model UserSubscription {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  plan_code        String    @default("pro")
  billing_cycle    String
  status           String
  currency         String    @default("INR")
  amount_paid      Decimal?  @db.Decimal(10, 2)
  payment_provider String?
  payment_id       String?
  payment_order_id String?
  started_at       DateTime? @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  next_billing_at  DateTime? @db.Timestamptz(6)
  cancelled_at     DateTime? @db.Timestamptz(6)
  metadata         Json      @default("{}")
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([user_id, created_at])
  @@map("user_subscriptions")
}

model SubscriptionPayment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  subscription_id String?   @db.Uuid
  plan_code       String    @default("pro")
  billing_cycle   String
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("INR")
  provider        String?
  payment_id      String?
  order_id        String?   @unique
  status          String
  paid_at         DateTime? @db.Timestamptz(6)
  raw_payload     Json      @default("{}")
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([user_id])
  @@map("subscription_payments")
}

// ---------- Chat and calls ----------

model ChatRoom {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id           String    @db.Uuid
  doctor_id            String    @db.Uuid
  last_message_at      DateTime? @default(now()) @db.Timestamptz(6)
  last_message_text    String?
  unread_count_patient Int       @default(0)
  unread_count_doctor  Int       @default(0)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([patient_id, doctor_id])
  @@index([doctor_id])
  @@map("chat_rooms")
}

model ChatMessage {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id            String   @db.Uuid
  sender_id          String   @db.Uuid
  text               String
  type               String   @default("text")
  attachment_url     String?
  is_read            Boolean  @default(false)
  reply_to_id        String?  @db.Uuid
  is_encrypted       Boolean  @default(false)
  encrypted_payload  String?
  encryption_version Int?     @db.SmallInt
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([room_id, created_at(sort: Desc)])
  @@map("chat_messages")
}

model ChatKeyBackup {
  user_id            String   @id @db.Uuid
  public_key         String
  wrapped_secret_key String
  wrap_alg           String   @default("aes-gcm-v1")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("chat_e2ee_key_backups")
}

model CallSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id    String    @db.Uuid
  caller_id  String    @db.Uuid
  type       String
  status     String    @default("ringing")
  ended_at   DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([room_id, created_at])
  @@map("call_sessions")
}

model InAppNotification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  type       String
  title      String
  body       String
  data       Json?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, is_read, created_at])
  @@map("in_app_notifications")
}

// ---------- Reports ----------

model MedicalReport {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id      String    @db.Uuid
  file_name       String
  file_path       String
  mime_type       String    @default("application/octet-stream")
  file_size_bytes BigInt?
  source          String    @default("upload")
  report_type     String?
  analysis_status String    @default("pending")
  ai_summary      String?
  ai_key_points   Json      @default("[]")
  ai_structured   Json      @default("{}")
  extracted_text  String?
  analysis_error  String?
  analyzed_at     DateTime? @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  deleted_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([patient_id, file_path])
  @@index([patient_id, created_at])
  @@map("medical_reports")
}

model MedicalReportChatMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id  String   @db.Uuid
  patient_id String   @db.Uuid
  role       String
  content    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([report_id, created_at])
  @@map("medical_report_chat_messages")
}

model MedicalReportChunk {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id        String                       @db.Uuid
  patient_id       String                       @db.Uuid
  chunk_index      Int
  content          String
  chunk_char_count Int                          @default(0)
  embedding        Unsupported("vector(1536)")?
  metadata         Json                         @default("{}")
  created_at       DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([report_id, chunk_index])
  @@index([patient_id])
  @@map("medical_report_chunks")
}

// ---------- CD4 AI ----------

model AiChatConversation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  mode             String   @default("assistant")
  concern          String   @default("General")
  title            String   @default("AI Conversation")
  clinical_summary String   @default("")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([user_id, updated_at])
  @@map("ai_chat_conversations")
}

model AiChatMessage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id  String   @db.Uuid
  user_id          String   @db.Uuid
  sender           String
  text             String
  show_consult_now Boolean  @default(false)
  metadata         Json     @default("{}")
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([conversation_id, created_at])
  @@map("ai_chat_messages")
}

model AiTriageReport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id   String   @db.Uuid
  concern      String
  chat_history Json
  summary      String?
  pdf_url      String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([patient_id])
  @@map("ai_triage_reports")
}

model AiUsageStat {
  user_id                 String   @db.Uuid
  day_key                 String
  message_count           Int      @default(0)
  burst_count             Int      @default(0)
  burst_window_started_at DateTime @default(now()) @db.Timestamptz(6)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@id([user_id, day_key])
  @@map("ai_usage_stats")
}

model AiKnowledgeChunk {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source       String
  title        String
  chunk_index  Int
  content      String
  content_hash String
  embedding    Unsupported("vector(1536)")
  category     String
  audience     String                      @default("all")
  reviewed_on  DateTime?                   @db.Date
  created_at   DateTime                    @default(now()) @db.Timestamptz(6)

  @@unique([source, chunk_index])
  @@map("ai_knowledge_chunks")
}

model AiAgentEvent {
  id                 BigInt   @id @default(autoincrement())
  surface            String
  user_id            String?  @db.Uuid
  role               String?
  route              String
  tier               String?
  route_reason       String?
  model              String?
  input_tokens       Int      @default(0)
  cached_tokens      Int      @default(0)
  output_tokens      Int      @default(0)
  embedding_tokens   Int      @default(0)
  cost_usd           Decimal? @db.Decimal(12, 6)
  latency_ms         Int?
  cache_status       String   @default("skip")
  retrieved_chunks   Int      @default(0)
  top_score          Float?
  guard_flags        String[] @default([])
  unsupported_values Int      @default(0)
  error              String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@map("ai_agent_events")
}

// ---------- Community ----------

model CommunityPost {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id         String    @db.Uuid
  body              String
  image_url         String?
  media             Json      @default("[]")
  category          String    @default("general")
  status            String    @default("published")
  moderation_reason String?
  moderation_meta   Json      @default("{}")
  is_pinned         Boolean   @default(false)
  like_count        Int       @default(0)
  comment_count     Int       @default(0)
  share_count       Int       @default(0)
  deleted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, is_pinned, created_at(sort: Desc)])
  @@index([author_id])
  @@map("community_posts")
}

model CommunityPostComment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id           String    @db.Uuid
  author_id         String    @db.Uuid
  parent_id         String?   @db.Uuid
  content           String
  status            String    @default("published")
  moderation_reason String?
  moderation_meta   Json      @default("{}")
  deleted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([post_id, created_at])
  @@map("community_post_comments")
}

model CommunityPostLike {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([post_id, user_id])
  @@index([user_id])
  @@map("community_post_likes")
}

model CommunityPostReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id     String   @db.Uuid
  reporter_id String   @db.Uuid
  reason      String   @default("other")
  details     String?
  status      String   @default("open")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([post_id, reporter_id])
  @@map("community_post_reports")
}

model CommunityFollow {
  follower_id  String   @db.Uuid
  following_id String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@id([follower_id, following_id])
  @@index([following_id])
  @@map("community_follows")
}

model CommunityUserBlock {
  blocker_id      String   @db.Uuid
  blocked_user_id String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@id([blocker_id, blocked_user_id])
  @@map("community_user_blocks")
}

model CommunityMutedKeyword {
  user_id    String   @db.Uuid
  keyword    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([user_id, keyword])
  @@map("community_muted_keywords")
}

// ---------- Hospital ----------

model HospitalOnboardingRequest {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                 String   @default("new")
  registered_name        String
  display_name           String?
  facility_type          String
  registration_number    String
  registering_authority  String
  full_address           String
  city                   String
  state                  String
  pin_code               String
  authorized_person_name String
  designation            String
  mobile_number          String
  official_email         String
  hospital_admin_user_id String?  @db.Uuid
  hospital_login_email   String
  app_account_status     String   @default("created_pending_review")
  details                Json     @default("{}")
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("hospital_onboarding_requests")
}

model HospitalDoctor {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospital_admin_user_id String   @db.Uuid
  onboarding_request_id  String?  @db.Uuid
  doctor_id              String   @db.Uuid
  department             String?
  status                 String   @default("active")
  added_by               String?  @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([hospital_admin_user_id, doctor_id])
  @@map("hospital_doctors")
}

model HospitalPatient {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospital_admin_user_id String   @db.Uuid
  onboarding_request_id  String?  @db.Uuid
  doctor_id              String?  @db.Uuid
  patient_id             String   @db.Uuid
  status                 String   @default("active")
  notes                  String?
  added_by               String?  @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([hospital_admin_user_id, patient_id])
  @@map("hospital_patients")
}

// ---------- Platform ----------

model AppContentPage {
  key        String   @id
  title      String   @default("")
  body       String   @default("")
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("app_content_pages")
}

model SupportTicket {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  name        String    @default("")
  email       String    @default("")
  phone       String    @default("")
  subject     String    @default("")
  message     String    @default("")
  status      String    @default("open")
  resolved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("support_tickets")
}

model SecurityAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type String
  severity   String   @default("info")
  user_id    String?  @db.Uuid
  ip         String?
  source     String?
  context    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([event_type, created_at])
  @@map("security_audit_logs")
}
