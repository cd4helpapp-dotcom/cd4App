{
  "expo": {
    "name": "CD4",
    "slug": "cd4",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cd4.app",
      "associatedDomains": [
        "applinks:cd4.co.in",
        "applinks:www.cd4.co.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "CD4 uses speech recognition to convert your voice into text for AI guidance.",
        "NSMicrophoneUsageDescription": "CD4 uses your microphone for voice symptom input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cd4.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cd4.co.in"
            },
            {
              "scheme": "https",
              "host": "www.cd4.co.in"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@config-plugins/react-native-webrtc",
      "@react-native-google-signin/google-signin",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CD4 uses your microphone for voice symptom input.",
          "speechRecognitionPermission": "CD4 uses speech recognition to convert your voice into text for AI guidance."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CD4 uses your location to show nearby doctors and better local health services."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "CD4 adds booked consultations to your device calendar with reminders.",
          "remindersPermission": "CD4 uses reminders to alert you before your consultation."
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": ["./assets/call_ringtone.wav"]
        }
      ],
      "expo-image-picker",
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n-keep class com.oney.WebRTCModule.** { *; }\n-keep class io.agora.** { *; }\n-dontwarn io.agora.**",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-logo.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "CD4 uses your microphone for the AI voice assistant and calls with your doctor."
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "scheme": [
      "cd4",
      "com.cd4.app"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "abd33322-02c5-4b08-abf2-705108d9d9c7"
      }
    },
    "owner": "cd4ai"
  }
}
